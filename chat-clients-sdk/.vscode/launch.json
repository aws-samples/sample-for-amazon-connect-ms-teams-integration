      "internalConsoleOptions": "openOnSessionStart",
      "justMyCode": false,
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-west-2",
        "LOG_LEVEL": "debug",
        "TEAMS_TENANT_ID": "abcdef12-1234-5678-abcd-0abcd9876543",
        "TEAMS_APP_CLIENT_ID": "abcdef12-1234-5678-abcd-0abcd9876543",
        "TEAMS_APP_CLIENT_SECRET": "secret"
      }
    }
  ]
}
