{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // https://code.visualstudio.com/docs/editor/tasks-appendix
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lex-bedrock-lambda:terraform:deploy",
      "type": "shell",
      "command": "./deploy-terraform.sh",
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AWS_PROFILE": "default",
          "AWS_REGION": "us-west-2",
          // set to 'apply' to install or 'destroy' to remove the infrastructure
          "TERRAFORM_COMMAND": "apply",
          "DEPLOYMENT_BUCKET_NAME": "YOUR_DEPLOYMENT_S3_BUCKET", // deployment s3 bucket
          // "DEPLOYMENT_BUCKET_PATH": "YOUR_DEPLOYMENT_S3_BUCKET_KEY", // a sub-path (if necessary) where terraform will upload lambda zip file. do not prefix with '/'  path is already relative to the root of bucket.
          "LAMBDA_ROLE_ARN": "arn:aws:iam::YOUR_ACCOUNT:role/YOUR_LAMBDA_EXECUTION_ROLE",
          "LAMBDA_LAYER_ARN": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_ACCOUNT:layer:chat-clients-sdk:YOUR_LAYER_VERSION",
          // "SUBNET_IDS": "[\"subnet-123\", \"subnet-456\", \"subnet-789\"]",
          // "SECURITY_GROUP_IDS": "[\"sg-123\", \"sg-456\", \"sg-789\"]",
          "LOG_LEVEL": "debug",
          "CONNECT_INSTANCE_ARN": "arn:aws:connect:us-west-2:1234567890:instance/abcedf-abcde-12345-aaaa-abcdefghijk",
          "CONNECT_CONTACT_FLOW_ID": "abcedf-abcde-12345-aaaa-abcdefghijk",
          "STREAMING_ENDPOINT_ARN": "arn:aws:sns:us-west-2:1234567890:CONNECT_STREAM", // set to SNS ARN
          "CONNECT_SESSION_DDB_TABLE_NAME": "connect-session-table",
          "CONNECT_SESSION_DDB_TABLE_TTL": "3600", // 1 hour in seconds
          "USER_CHAT_CLIENT_TYPE": "SLACK", // set to 'SLACK' or 'WEB'
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "lex-bedrock-lambda:terraform:undeploy",
      "type": "shell",
      "command": "./deploy-terraform.sh",
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AWS_PROFILE": "default",
          "AWS_REGION": "us-west-2",
          // set to 'apply' to install or 'destroy' to remove the infrastructure
          "TERRAFORM_COMMAND": "destroy",
          "DEPLOYMENT_BUCKET_NAME": "YOUR_DEPLOYMENT_S3_BUCKET", // deployment s3 bucket
          // "DEPLOYMENT_BUCKET_PATH": "YOUR_DEPLOYMENT_S3_BUCKET_KEY", // a sub-path (if necessary) where terraform will upload lambda zip file. do not prefix with '/'  path is already relative to the root of bucket.
          "LAMBDA_ROLE_ARN": "arn:aws:iam::YOUR_ACCOUNT:role/YOUR_LAMBDA_EXECUTION_ROLE",
          "LAMBDA_LAYER_ARN": "arn:aws:lambda:YOUR_AWS_REGION:YOUR_ACCOUNT:layer:chat-clients-sdk:YOUR_LAYER_VERSION",
          // "SUBNET_IDS": "[\"subnet-123\", \"subnet-456\", \"subnet-789\"]",
          // "SECURITY_GROUP_IDS": "[\"sg-123\", \"sg-456\", \"sg-789\"]",
          "LOG_LEVEL": "debug",
          "CONNECT_INSTANCE_ARN": "arn:aws:connect:us-west-2:1234567890:instance/abcedf-abcde-12345-aaaa-abcdefghijk",
          "CONNECT_CONTACT_FLOW_ID": "abcedf-abcde-12345-aaaa-abcdefghijk",
          "STREAMING_ENDPOINT_ARN": "arn:aws:sns:us-west-2:1234567890:CONNECT_STREAM", // set to SNS ARN
          "CONNECT_SESSION_DDB_TABLE_NAME": "connect-session-table",
          "CONNECT_SESSION_DDB_TABLE_TTL": "3600", // 1 hour in seconds
          "USER_CHAT_CLIENT_TYPE": "SLACK", // set to 'SLACK' or 'WEB'
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "lex-bedrock-lambda:api:terraform:deploy",
      "type": "shell",
      "command": "./deploy-api-terraform.sh",
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AWS_PROFILE": "default",
          "AWS_REGION": "us-west-2",
          "AWS_ACCOUNT_ID": "YOUR_AWS_ACCOUNT",
          // set to 'apply' to install or 'destroy' to remove the infrastructure
          "TERRAFORM_COMMAND": "apply",
          "API_NAME": "connect-chat-api",
          "API_DESCRIPTION": "REST API that accepts messages from chat clients and invokes Amazon Connect",
          "API_STAGE_NAME": "YOUR_API_STAGE",
          "LAMBDA_PROXY_FUNCTION_NAME": "lex-bedrock-lambda",
          "LAMBDA_PROXY_FUNCTION_ARN": "arn:aws:lambda:us-east-1:YOUR_AWS_ACCOUNT:function:lex-bedrock-lambda",
          "IS_PRIVATE_API": "false",
          "API_VPC_ENDPOINT_ID": "", // set a value if IS_PRIVATE_API is "true"
          "API_GATEWAY_EXECUTION_ROLE_ARN": "",
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "lex-bedrock-lambda:api:terraform:undeploy",
      "type": "shell",
      "command": "./deploy-api-terraform.sh",
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AWS_PROFILE": "default",
          "AWS_REGION": "us-west-2",
          "AWS_ACCOUNT_ID": "YOUR_AWS_ACCOUNT",
          // set to 'apply' to install or 'destroy' to remove the infrastructure
          "TERRAFORM_COMMAND": "destroy",
          "API_NAME": "connect-chat-api",
          "API_DESCRIPTION": "REST API that accepts messages from chat clients and invokes Amazon Connect",
          "API_STAGE_NAME": "YOUR_API_STAGE",
          "LAMBDA_PROXY_FUNCTION_NAME": "lex-bedrock-lambda",
          "LAMBDA_PROXY_FUNCTION_ARN": "arn:aws:lambda:us-east-1:YOUR_AWS_ACCOUNT:function:lex-bedrock-lambda",
          "IS_PRIVATE_API": "false",
          "API_VPC_ENDPOINT_ID": "", // set a value if IS_PRIVATE_API is "true"
          "API_GATEWAY_EXECUTION_ROLE_ARN": "",
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "lex-bedrock-lambda:cloudwatch",
      "type": "shell",
      "command": "aws",
      "args": [
        "logs",
        "tail",
        "/aws/lambda/lex-bedrock-lambda",
        "--profile",
        "default",
        "--region",
        "us-west-2"
      ],
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
